# migui-runner: the root half of the migrate web UI (DESIGN.md section 8.1). Installed by migui/deploy/install.sh.
#
# Hardening note (DEPLOY.md section 6): every 'migrate' this unit starts is
# its child and inherits its namespaces, seccomp filter and cgroup firewall. migrate needs the network (both clouds'
# APIs, iSCSI to the source storage, RBD to Ceph), /dev, /sys (SCSI rescans), /etc/iscsi, /run (iscsid, multipathd)
# and root's capabilities. So PrivateNetwork=, ProtectSystem=strict, PrivateDevices=, IPAddressDeny=,
# RestrictAddressFamilies= and CapabilityBoundingSet= would break every migration; only what leaves migrate whole
# is set here. The runner's own exposure is its unix socket (0660 root:migui, SO_PEERCRED = migui) and 9 messages.
# No ProtectClock= either (1.2.3, found on a real Ubuntu 22.04 host): on systemd <= 249 it adds DeviceAllow=char-rtc r,
# and any DeviceAllow= turns DevicePolicy=auto into closed, so migrate and os-brick get EPERM opening /dev/sdX (the
# source LUN) and the failed flush left the iSCSI session logged in. install.sh refuses a runner with a DeviceAllow=.
[Unit]
Description=migrate web UI runner (root; starts migrate for migui-web)
Documentation=file:///opt/migui/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/migui/bin/migui-runner
# A runner restart must never kill a running migrate (DESIGN.md section 8.1): only the runner process is stopped; migrate
# runs in its own session, writes its output to a file (not a pipe) and finishes on its own.
KillMode=process
Restart=on-failure
RestartSec=5
UMask=0077
RuntimeDirectory=migui
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# /var/lib/migui and /var/log/migui are made by install.sh with the modes of DEPLOY.md section 6 (root:migui): not
# StateDirectory=/LogsDirectory=, whose ownership fix-up at each start would hand the audit file to root:root.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectHostname=yes
SystemCallArchitectures=native
# Operator settings for migrate (MIG_CONF=..., MIG_DEFAULT_OPTS=...): systemctl edit migui-runner
# [Service]
# Environment=MIG_CONF=/opt/mig/migrate.conf

[Install]
WantedBy=multi-user.target
